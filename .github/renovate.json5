{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // No Dependency Dashboard issue. The pull requests and the Mend web portal show the updates.
  dependencyDashboard: { enabled: false },
  // Once a week, as unref's, in batches rather than one pull request per dependency.
  schedule: ["before 4am on Wednesday"],
  // A release that is a few days old has had time to be yanked or reported as malicious.
  minimumReleaseAge: "7 days",
  // uv.lock also updates its transitive dependencies.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on Wednesday"],
  },
  enabledManagers: ["github-actions", "pep621"],
  packageRules: [
    {
      // Runners stay on ubuntu-latest.
      matchManagers: ["github-actions"],
      matchDatasources: ["github-runners"],
      enabled: false,
    },
    {
      groupName: "GitHub Actions",
      matchManagers: ["github-actions"],
    },
    {
      groupName: "Python dependencies",
      matchManagers: ["pep621"],
    },
    {
      // mirror.py sets the version of unref, once it is on PyPI.
      matchPackageNames: ["unref"],
      enabled: false,
    },
  ],
}
